{
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pear *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(node *)",
      "Bash(bare *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-updater.js",
            "timeout": 10,
            "statusMessage": "guard: updater files"
          }
        ]
      }
    ]
  }
}
