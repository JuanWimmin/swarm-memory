{
  "name": "swarm-memory",
  "version": "0.1.12",
  "description": "P2P team memory for smart-contract projects. Shared knowledge graph over the swarm, installed and updated via Pear.",
  "private": true,
  "bin": "bin.mjs",
  "upgrade": "pear://ino4ymu381ouhyo14u6sg5ursbto4irt4n5mhhzjkk8a7mwgd6iy",
  "scripts": {
    "format": "prettier . --write",
    "test": "brittle-bare test/index.js",
    "lint": "prettier . --check && lunte",
    "start": "bare bin.mjs --no-updates",
    "make": "node scripts/make.js",
    "make:darwin-arm64": "bare-build --name swarm-memory --standalone --host darwin-arm64 --out ./out/darwin-arm64 bin.mjs",
    "make:darwin-x64": "bare-build --name swarm-memory --standalone --host darwin-x64 --out ./out/darwin-x64 bin.mjs",
    "make:linux-arm64": "bare-build --name swarm-memory --standalone --host linux-arm64 --out ./out/linux-arm64 bin.mjs",
    "make:linux-x64": "bare-build --name swarm-memory --standalone --host linux-x64 --out ./out/linux-x64 bin.mjs",
    "make:win32-arm64": "bare-build --name swarm-memory --standalone --host win32-arm64 --out ./out/win32-arm64 bin.mjs",
    "make:win32-x64": "bare-build --name swarm-memory --standalone --host win32-x64 --out ./out/win32-x64 bin.mjs"
  },
  "dependencies": {
    "autobase": "^7.28.1",
    "b4a": "^1.8.1",
    "bare-fs": "^4.5.6",
    "bare-os": "^3.9.0",
    "bare-path": "^3.0.0",
    "bare-process": "^4.5.0",
    "bare-storage": "^1.1.0",
    "blind-pairing": "^2.3.1",
    "corestore": "^7.9.2",
    "framed-stream": "^1.0.1",
    "graceful-goodbye": "^1.3.3",
    "hello-pear-worker": "^1.0.0",
    "hyperbee": "^2.27.3",
    "hyperswarm": "^4.17.0",
    "paparam": "^1.10.1",
    "pear-runtime": "^1.2.0",
    "protomux-wakeup": "^2.9.0",
    "ready-resource": "^1.2.0",
    "which-runtime": "^1.4.0",
    "z32": "^1.1.0"
  },
  "devDependencies": {
    "bare-build": "^1.0.2",
    "bare-runtime": "1.29.4",
    "brittle": "^3.19.0",
    "lunte": "^1.2.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/holepunchto/hello-pear-bare.git"
  },
  "author": "Holepunch Inc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/hello-pear-bare/issues"
  }
}
